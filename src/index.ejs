	<script type="module">
	  import { initializeApp } from "https://www.gstatic.com/firebasejs/12.18.0/firebase-app.js";
	  import {
	    getAuth,
	    createUserWithEmailAndPassword,
	    signInWithEmailAndPassword,
	    signOut,
	    onAuthStateChanged,
	    GoogleAuthProvider,
	    signInWithPopup,
	    EmailAuthProvider,
	    reauthenticateWithCredential
	  } from "https://www.gstatic.com/firebasejs/12.18.0/firebase-auth.js";
	
	  const firebaseConfig = {
	    apiKey: "AIzaSyDYBctcyZqAEW0pN9uOF37PMu-yoXmb0cc",
	    authDomain: "pvz-roam.firebaseapp.com",
	    projectId: "pvz-roam",
	    storageBucket: "pvz-roam.firebasestorage.app",
	    messagingSenderId: "982409156504",
	    appId: "1:982409156504:web:bfcd621cfd64ad90abfded"
	  };
	
	  const app = initializeApp(firebaseConfig);
	  const auth = getAuth(app);
	  const googleProvider = new GoogleAuthProvider();
	
	  // expose these globally so our other game scripts (loaded as plain
	  // non-module scripts) can call into Firebase auth
	  window.firebaseAuth = auth;
	  window.firebaseCreateUser = createUserWithEmailAndPassword;
	  window.firebaseSignIn = signInWithEmailAndPassword;
	  window.firebaseSignOut = signOut;
	  // wraps signInWithPopup so other scripts don't need to import
	  // GoogleAuthProvider themselves - just call window.firebaseSignInWithGoogle()
	  window.firebaseSignInWithGoogle = function () {
	    return signInWithPopup(auth, googleProvider);
	  };
	  // Re-proves the signed-in user's password before a destructive action
	  // (wipe data) - throws (auth/wrong-password etc) if it doesn't match, so
	  // callers should await this and only proceed on success. No-op wrapper
	  // around Firebase's own reauth, so we don't need to build/store a second
	  // password check of our own on the server.
	  window.firebaseReauthenticate = function (password) {
	    var user = auth.currentUser;
	    if (!user || !user.email) {
	      return Promise.reject(new Error('Not signed in.'));
	    }
	    return reauthenticateWithCredential(user, EmailAuthProvider.credential(user.email, password));
	  };
	
	  // Firebase checks local persistence asynchronously, so on page load we don't
	  // yet know whether someone's signed in. window.firebaseAuthReady resolves
	  // exactly once, the first time Firebase tells us (with the user, or null) -
	  // anything that needs to know "are we signed in?" before doing its own thing
	  // (e.g. opening the game socket) should `await` this first.
	  let resolveAuthReady;
	  window.firebaseAuthReady = new Promise((resolve) => {
	    resolveAuthReady = resolve;
	  });
	  let authReadyResolved = false;

	  // Always call this instead of reading a token you stashed earlier - it
	  // returns null if signed out, and transparently refreshes an expired
	  // token if signed in, so it's always safe to call right before connecting.
	  window.getFirebaseIdToken = async function () {
	    if (!auth.currentUser) {
	      return null;
	    }
	    return await auth.currentUser.getIdToken();
	  };
	
	  onAuthStateChanged(auth, (user) => {
	    if (user) {
	      console.log('Firebase: signed in as', user.email);
	    } else {
	      console.log('Firebase: not signed in');
	    }
	    if (!authReadyResolved) {
	      authReadyResolved = true;
	      resolveAuthReady(user);
	    }
	    // defined in templates/auth.ejs - swaps the login/signup form for the
	    // "signed in as ..." view (or back), whenever auth state changes
	    if (typeof window.renderAuthUI === 'function') {
	      window.renderAuthUI(user);
	    }
	  });
	</script>


