<script>
  // window.customFontsReady is exposed so game boot (see client.js) can
  // explicitly await it before any rendering starts, instead of hoping the
  // fire-and-forget load finishes in time. It always resolves (never
  // rejects) using allSettled, so one font failing doesn't block the others
  // or hang boot - each outcome is logged clearly so a real failure (bad
  // path, 404, server MIME issue, etc) is visible in the console instead of
  // silently vanishing.
  window.customFontsReady = Promise.allSettled([
    { name: 'Burbank Big Condensed', url: '/assets/fonts/BurbankBigCondensedBold.otf' },
    { name: 'Brianne\'s Hand', url: '/assets/fonts/BriannesHand.ttf' },
  ].map(function ({ name, url }) {
    return new FontFace(name, `url(${url})`)
      .load()
      .then(function (loadedFont) {
        document.fonts.add(loadedFont);
        console.log(`[FONT] "${name}" loaded successfully from ${url}`);
        return loadedFont;
      })
      .catch(function (err) {
        console.error(`[FONT] "${name}" FAILED to load from ${url} - will fall back to a default font wherever it's used. Error:`, err);
        throw err;
      });
  }));
</script>

