		const key = generateKey();
		setSelectedKey(key);
		setShopEntryDraft(null);
		setShopDraft({
			key,
			name: 'New Shop',
			description: '',
			dismissible: true,
			itemTypes: {},
			unitTypes: {},
			shopClass: '',
			streamMode: 1,
			rest: {},
